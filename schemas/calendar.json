{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tickdeck calendar card data",
  "type": "object",
  "properties": {
    "events": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "allDay": {
            "type": "boolean"
          },
          "location": {
            "type": "string",
            "maxLength": 200
          },
          "link": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^(primary|positive|negative|\\d{1,3} \\d{1,3} \\d{1,3})$"
          }
        },
        "required": [
          "title",
          "start"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "events"
  ],
  "additionalProperties": {}
}
