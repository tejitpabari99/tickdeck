{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tickdeck calendar card data file",
  "description": "Data file (data.json) for a calendar card: the data key is bound to the calendar payload. Not expressible in JSON Schema, enforced by the validator: data must be an object unless error is a non-empty string; error \"\" is treated as null (default null); updatedAt must be an RFC 3339 timestamp with offset or Z. When error is set the payload is not validated. The generic data.json leaves the payload open; the validator applies the per-type payload schema chosen by the card type.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "data": {
      "title": "tickdeck calendar card data",
      "type": "object",
      "properties": {
        "events": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "allDay": {
                "type": "boolean"
              },
              "location": {
                "type": "string",
                "maxLength": 200
              },
              "link": {
                "type": "string"
              },
              "color": {
                "type": "string",
                "pattern": "^(primary|positive|negative|\\d{1,3} \\d{1,3} \\d{1,3})$"
              }
            },
            "required": [
              "title",
              "start"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "events"
      ],
      "additionalProperties": {}
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "updatedAt": {
      "type": "string"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": {},
  "allOf": [
    {
      "if": {
        "properties": {
          "error": {
            "enum": [
              null,
              ""
            ]
          }
        }
      },
      "then": {
        "required": [
          "data"
        ]
      }
    }
  ]
}
