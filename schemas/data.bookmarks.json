{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tickdeck bookmarks card data file",
  "description": "Data file (data.json) for a bookmarks card: the data key is bound to the bookmarks payload. Not expressible in JSON Schema, enforced by the validator: data must be an object unless error is a non-empty string; error \"\" is treated as null (default null); updatedAt must be an RFC 3339 timestamp with offset or Z. When error is set the payload is not validated. The generic data.json leaves the payload open; the validator applies the per-type payload schema chosen by the card type.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "data": {
      "title": "tickdeck bookmarks card data",
      "type": "object",
      "properties": {
        "groups": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 100
              },
              "color": {
                "type": "string",
                "pattern": "^(primary|positive|negative|\\d{1,3} \\d{1,3} \\d{1,3})$"
              },
              "links": {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "url": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "icon": {
                      "type": "string",
                      "maxLength": 8
                    }
                  },
                  "required": [
                    "title",
                    "url"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "links"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "groups"
      ],
      "additionalProperties": {}
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "updatedAt": {
      "type": "string"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": {},
  "allOf": [
    {
      "if": {
        "properties": {
          "error": {
            "enum": [
              null,
              ""
            ]
          }
        }
      },
      "then": {
        "required": [
          "data"
        ]
      }
    }
  ]
}
