{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tickdeck bookmarks card data",
  "type": "object",
  "properties": {
    "groups": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "color": {
            "type": "string",
            "pattern": "^(primary|positive|negative|\\d{1,3} \\d{1,3} \\d{1,3})$"
          },
          "links": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "url": {
                  "type": "string"
                },
                "description": {
                  "type": "string",
                  "maxLength": 200
                },
                "icon": {
                  "type": "string",
                  "maxLength": 8
                }
              },
              "required": [
                "title",
                "url"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "links"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "groups"
  ],
  "additionalProperties": {}
}
